# 로컬 개발용: 이 파일을 .env.local 로 복사해서 키를 넣으세요. (.env.local 은 git 에 올라가지 않습니다)
# 배포(Vercel)에서는 Project Settings → Environment Variables 에 같은 이름으로 넣습니다.
# VITE_ 를 붙이지 마세요 — 붙이면 브라우저 코드에 키가 노출됩니다.
VISITJEJU_API_KEY=

# AI 가이드(채팅)용 Claude API 키 — console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# (선택) 사용할 모델. 비워 두면 claude-opus-5-5. 더 싸고 빠르게 쓰려면 claude-sonnet-5-5 나 claude-haiku-5-5
ANTHROPIC_MODEL=
